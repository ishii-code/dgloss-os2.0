# === Anthropic ===
# 本番は Secret Manager から注入する。ローカル試用のみ .env を使う（.gitignore 済）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# === Google Chat アプリ ===
# Chatアプリを登録した GCP プロジェクト番号（JWT audience 検証に使用）
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
# Chatアプリのサービスアカウントメール（REST 追記投稿用。任意）
CHAT_APP_SA_EMAIL=dgloss-brain@PROJECT_ID.iam.gserviceaccount.com

# === ユーザーOAuth（Drive/Gmail を本人権限で検索）===
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
OAUTH_REDIRECT_URI=https://dgloss-brain-xxxx.a.run.app/oauth/callback

# === 運用 ===
PORT=8080
# モックモード: true なら Google/Anthropic を呼ばずスタブ応答（GCP設定前のローカル起動用）
MOCK_MODE=true
# 1質問あたりの入力トークン上限（COST_DESIGN §2⑥）
MAX_INPUT_TOKENS=100000
