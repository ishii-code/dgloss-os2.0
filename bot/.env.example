# === Anthropic ===
# 本番は Vercel 環境変数から注入する。ローカル試用のみ .env を使う（.gitignore 済）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# === Google Chat アプリ（GCPはAPIとOAuthのみ・computeはVercel）===
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
CHAT_APP_SA_EMAIL=dgloss-brain@PROJECT_ID.iam.gserviceaccount.com
# ボット→Chat投稿用のSA鍵JSON（1行に圧縮して格納）
CHAT_APP_SA_KEY_JSON=

# === ユーザーOAuth（Drive/Gmail を本人権限で検索）===
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
OAUTH_REDIRECT_URI=https://dgloss-brain.vercel.app/oauth/callback

# === トークン保管・暗号化（SECURITY 判断1・T1）===
# Supabase（dgloss標準 TECH_STACK）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx
SUPABASE_TOKEN_TABLE=oauth_tokens
SUPABASE_QA_TABLE=qa_logs
SUPABASE_SUMMARY_TABLE=customer_summaries
# トークン暗号化のマスター鍵(KEK・base64・32byte)。本番はVercel環境変数へ
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_MASTER_KEY=

# === 運用 ===
# 一括失効API(/admin/revoke-all)の管理シークレット（本番は必ず設定）
ADMIN_API_TOKEN=change-me-strong-random
# 非同期回答: off=同期 / inline=応答後にwaitUntilで背景実行(Vercel)
# ローカル確認は off でよいが、本番(Vercel)は inline 推奨（受付3秒以内=NFR-1のため）
ASYNC_MODE=off
# 夜間バッチ(/jobs/*)保護: Vercel Cron の Authorization: Bearer と一致させる
JOBS_API_TOKEN=change-me-strong-random
PORT=8080
# モックモード: true なら外部を呼ばずスタブ応答（設定前のローカル起動用）
MOCK_MODE=true
# 1質問あたりの入力トークン上限（COST_DESIGN §2⑥）
MAX_INPUT_TOKENS=100000
