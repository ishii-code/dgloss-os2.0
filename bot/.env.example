# === Anthropic ===
# 本番は Secret Manager から注入する。ローカル試用のみ .env を使う（.gitignore 済）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# === Google Chat アプリ ===
# Chatアプリを登録した GCP プロジェクト番号（JWT audience 検証に使用）
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
# Chatアプリのサービスアカウントメール（REST 追記投稿用。任意）
CHAT_APP_SA_EMAIL=dgloss-brain@PROJECT_ID.iam.gserviceaccount.com

# === ユーザーOAuth（Drive/Gmail を本人権限で検索）===
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
OAUTH_REDIRECT_URI=https://dgloss-brain-xxxx.a.run.app/oauth/callback

# === トークン暗号化・保管（SECURITY 判断1・T1）===
# Cloud KMS の鍵リソース名（本番）
KMS_KEY_NAME=projects/PROJECT_ID/locations/asia-northeast1/keyRings/dgloss-brain/cryptoKeys/token-encryption
# Firestore のトークン保管コレクション名
FIRESTORE_TOKEN_COLLECTION=oauth_tokens
# 一括失効API(/admin/revoke-all)の管理シークレット（本番は必ず設定）
ADMIN_API_TOKEN=change-me-strong-random
# ローカル開発(MOCK)専用の簡易マスター鍵（base64・32byte）。本番では未設定でよい
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEV_MASTER_KEY=

# === 非同期回答（S4）===
# off=同期 / inline=プロセス内背景(Cloud RunはCPU常時割当推奨) / cloudtasks=Cloud Tasks
ASYNC_MODE=off
# ASYNC_MODE=cloudtasks のとき必要
TASKS_QUEUE_PATH=projects/PROJECT_ID/locations/asia-northeast1/queues/dgloss-brain
TASKS_WORKER_URL=https://dgloss-brain-xxxx.a.run.app/tasks/answer
TASKS_INVOKER_SA=dgloss-brain@PROJECT_ID.iam.gserviceaccount.com
TASKS_SHARED_TOKEN=change-me-strong-random

# === 運用 ===
PORT=8080
# モックモード: true なら Google/Anthropic を呼ばずスタブ応答（GCP設定前のローカル起動用）
MOCK_MODE=true
# 1質問あたりの入力トークン上限（COST_DESIGN §2⑥）
MAX_INPUT_TOKENS=100000
